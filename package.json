{
  "name": "growth-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:terminal": "npm run build && python test/terminal-smoke.py",
    "test:install": "npm run build && python test/install-smoke.py",
    "test:codex": "npm run build && node test/codex-session.mjs",
    "mcp": "node dist/mcp.js",
    "vault": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
