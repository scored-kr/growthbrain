{
  "name": "growth-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && node scripts/build-browser-modules.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:terminal": "npm run build && python3 test/terminal-smoke.py && python3 test/lock-terminal.py && python3 test/deletion-terminal.py",
    "test:install": "npm run build && python3 test/install-smoke.py",
    "test:agent-install": "npm run build && python3 test/agent-install.py",
    "test:search": "npm run build && node test/search-evaluation.mjs",
    "test:extraction": "npm run build && node test/extraction-evaluation.mjs",
    "test:retrieval": "npm run build && node test/retrieval-evaluation.mjs",
    "test:hooks:codex": "npm run build && node test/agent-codex-session.mjs",
    "test:codex": "npm run build && node test/codex-session.mjs",
    "test:browser": "npm run build && node test/browser-session.mjs",
    "test:ui": "node test/ui-fixtures.mjs && node test/import-ui.mjs && node test/app-ui.mjs && node test/account-ui.mjs",
    "test:native-install": "npm run build && python3 test/native-install.py",
    "mcp": "node dist/mcp.js",
    "vault": "node dist/cli.js",
    "test:recovery": "npm run build && python3 test/recovery-terminal.py",
    "verify:skills": "node scripts/verify-skills.mjs",
    "doctor:ign8t": "node scripts/ign8t-doctor.mjs",
    "test:ign8t-install": "python3 test/ign8t-install.py",
    "test:local": "npm test && npm run verify:skills && npm run test:ign8t-install && npm run test:install && npm run test:agent-install && npm run test:native-install && npm run test:terminal && npm run test:recovery && npm run test:ui",
    "validate:extension": "npm run build && node scripts/validate-extension.mjs",
    "test:personalization": "npm run build && node test/personalization-evaluation.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
