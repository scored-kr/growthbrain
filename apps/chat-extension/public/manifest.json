{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Growth Brain",
  "version": "0.2.2",
  "description": "승인한 상세페이지 원고와 최신 확정안을 ChatGPT와 Claude에서 이어 씁니다.",
  "permissions": ["storage", "alarms"],
  "action": { "default_popup": "popup.html", "default_title": "Growth Brain 연결" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
    "js": ["content.js"], "run_at": "document_start", "all_frames": false
  }],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:43127"
  }
}
